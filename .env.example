# Viral Clip Studio — copy to .env and fill in. NEVER commit a real .env to GitHub.
# Phase 1 needs NO key. Gemini is Phase 2 only.
GEMINI_API_KEY=
VCS_HOST=127.0.0.1
VCS_PORT=8000
# Default language: English. Captions in English words.
# Options: en (English, default), hinglish (Roman Hinglish), hi (Hindi)
WHISPER_LANGUAGE=en
WHISPER_MODEL=base
